{
  "name": "@99galaxy/dsh-plugin-market",
  "version": "1.2.0",
  "type": "module",
  "description": "DSH 插件市场：从左侧栏浏览 awesome-dsh-plugin 目录并一键安装。Browse the awesome-dsh-plugin catalog from the sidebar and install plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99galaxy/dsh-plugin-market.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "market-core.mjs",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.1.5-rc.1 <0.3.0",
    "node": ">=22.19"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
